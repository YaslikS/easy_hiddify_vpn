# Copy this file to keystore.properties and fill in the real values.
# keystore.properties is gitignored and must never be committed.
#
# The same values can be provided through environment variables (useful for CI):
#   RELEASE_STORE_FILE, RELEASE_STORE_PASSWORD, RELEASE_KEY_ALIAS, RELEASE_KEY_PASSWORD

# Absolute path on this machine. Keep the keystore outside the repository,
# for example: /Users/<user>/.android-keys/easy_hiddify/release.jks
storeFile=/absolute/path/to/release.jks
storePassword=CHANGE_ME
keyAlias=easy_key
keyPassword=CHANGE_ME
